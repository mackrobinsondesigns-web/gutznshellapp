{
  "version": 2,
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "devCommand": "npx expo",
  "cleanUrls": true,
  "framework": null,
  "rewrites": [
    {
      "source": "/_next/:path*",
      "destination": "/_next/:path*"
    },
    {
      "source": "/(icons|images|assets)/:path*",
      "destination": "/$1/:path*"
    },
    {
      "source": "/manifest.json",
      "destination": "/manifest.json"
    },
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/contact.vcf",
      "destination": "/contact.vcf"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
