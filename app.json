{
  "expo": {
    "name": "GutzNShellApp",
    "slug": "GutzNShellApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gutznshellapp",
    "userInterfaceStyle": "dark",
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "publicPath": "./public",
      "pwa": {
        "enabled": true,
        "themeColor": "#000000",
        "backgroundColor": "#000000",
        "manifest": {
          "background_color": "#000000",
          "theme_color": "#000000",
          "display": "standalone",
          "orientation": "portrait"
        },
        "meta": {
          "apple-mobile-web-app-status-bar-style": "black-translucent",
          "theme-color": "#000000"
        }
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://gutznshell.com"
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": ""
    }
  }
}
