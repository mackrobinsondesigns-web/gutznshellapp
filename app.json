{
  "expo": {
    "name": "GutzNShellApp",
    "slug": "GutzNShellApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gutznshellapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "publicPath": "./public",
      "pwa": {
        "enabled": false
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://gutznshell.com"
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": ""
    }
  }
}
